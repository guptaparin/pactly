# PayPal sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: webhook ID from the same app (enables signature verification)
PAYPAL_WEBHOOK_ID=

# AI: free Google Gemini key from https://aistudio.google.com/apikey (default)
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
# Optional alternative: Anthropic Claude (set AI_PROVIDER=anthropic)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Public URL of this deployment (used in Telegram buttons and PayPal return links).
# On Vercel it is detected automatically; set it if you use a custom domain.
APP_URL=

# Telegram bot (optional): create one with @BotFather, then open /api/telegram/setup?key=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# MCP server (optional): if set, agents must send "Authorization: Bearer <MCP_API_KEY>"
MCP_API_KEY=

# Daily agent sweep (vercel.json cron). Vercel sends this automatically when set.
CRON_SECRET=

# Storage (auto-added when you connect Upstash Redis in Vercel; omit locally to use JSON files in ./data)
KV_REST_API_URL=
KV_REST_API_TOKEN=
